# Sunucudaki canlı ayarlar. Depo klasöründe ".env" adıyla kopyala ve doldur:
#   cp deploy/env.prod.example .env
#   nano .env
# ".env" git'e GİRMEZ (.gitignore'da) ve bu sunucudan dışarı çıkmamalı.

# Sitenin adresi: https:// ve sondaki / OLMADAN, yalnızca alan adı.
#   Kendi alan adın varsa:        gorevtakip.ornek.com   (DNS'te A kaydı sunucunun genel IP'sine bakmalı)
#   Alan adın yoksa (ücretsiz):   IP adresinin noktalarını tire yap + .sslip.io
#                                 örn. IP 129.151.10.20 → 129-151-10-20.sslip.io
SITE_ADDRESS=

POSTGRES_USER=gorevtakip
POSTGRES_DB=gorevtakip
# Rastgele ve uzun olsun; üretmek için sunucuda:  openssl rand -hex 24
# (yalnızca harf/rakam üreten komutu kullan: ; ve = karakterleri bağlantı dizesini bozar)
POSTGRES_PASSWORD=

# Token'ları imzalayan gizli anahtar (EN AZ 32 karakter). Üretmek için:  openssl rand -hex 48
# Değiştirirsen herkes çıkış yapmış olur (eski token'lar geçersizleşir). Kimseyle paylaşma.
JWT_KEY=
