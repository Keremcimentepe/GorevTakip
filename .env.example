# docker compose için ayarlar. Bu dosyayı ".env" adıyla kopyala ve gerekirse düzenle:
#   cp .env.example .env
# ".env" dosyası git'e GİRMEZ (.gitignore'da).
#
# Bu değerler yalnızca YEREL kullanım içindir (veritabanı yalnızca bu bilgisayardan erişilebilir).
# Canlı ortamın (Render + Neon) ayarları Render panelinde girilir; bkz. DEPLOY.md.

POSTGRES_USER=gorevtakip
# Yerel `dotnet run` (appsettings.Development.json) bu değerlerle bağlanır; değiştirirsen orayı da güncelle.
# Parolada ; veya = olmasın (bağlantı dizesini bozar).
POSTGRES_PASSWORD=gorevtakip
POSTGRES_DB=gorevtakip

# Token'ları imzalayan gizli anahtar. EN AZ 32 karakter olmalı.
# Gerçek bir ortamda tahmin edilemez olmalı; rastgele üretmek için:  openssl rand -base64 48
JWT_KEY=yerel-docker-icin-gelistirme-anahtari-0123456789-abcdef
